// fluid.config: settings for how main.fluid becomes .fx3 and then Python / C++.
// JSON with comments. Every key is optional; anything left out uses the
// default in fluid.config.schema.json. See FLUID_SPEC.md sections 8 and 11.
//
// KNOWN keys are checked against the schema. ANY OTHER key is allowed too:
// the LLM reads it as a requirement for the generated code, and asks you if
// it's unclear (see the "custom keys" at the bottom).
{
  "$schema": "./fluid.config.schema.json",

  "project": {
    "entry": "main.fluid",
    "fx3Out": "build/fx3",        // generated .fx3 (you may edit these)
    "targetOut": "build/out"      // generated Python / C++
  },

  "target": {
    "language": "python",         // "python" | "cpp". Must match `target` in main.fluid.
                                  // Only the section for this language is used.

    "python": {
      "version": "3.12",
      "packaging": "pyproject-uv",
      "typeChecker": "pyright",
      "typeCheckStrictness": "strict",
      "formatter": "ruff",
      "linter": "ruff",
      "docstringStyle": "google",
      "dataModels": "pydantic",   // `thing` blocks become pydantic models
      "webFramework": "fastapi",
      "testFramework": "pytest",
      "cli": "typer",
    },

    "cpp": {
      // Used when "language" is "cpp". Switching languages only means editing
      // the line above.
      "standard": "c++23",
      "compiler": "clang",
      "buildSystem": "cmake",
      "packageManager": "vcpkg",
      "output": "executable",
      "platforms": ["linux", "macos"],

      "fileLayout": "header-source",   // .hpp + .cpp per module
      "namespace": "tracker",

      "memory": "value-and-raii",      // values + std containers; unique_ptr only when needed
      "errorStyle": "expected",        // fx3 @fails -> std::expected<T, Error>
      "exceptions": false,             // -fno-exceptions
      "integerTypes": "fixed-width",   // std::int64_t, matching fx3's int
      "overflowChecks": "builtin-checked",
      "boundsChecks": "always",
      "concurrency": "jthread",

      "libraries": {
        "json": "nlohmann-json",
        "http": "cpp-httplib",
        "sql": "sqlitecpp",
        "logging": "spdlog",
        "testing": "catch2",
        "cli": "cli11",
      },

      "optimization": "O2",
      "warnings": "extra",
      "warningsAsErrors": true,
      "sanitizers": ["address", "undefined"],  // debug builds
      "staticAnalysis": "clang-tidy",
      "formatStyle": "llvm",
      "guidelines": ["cpp-core-guidelines"],
    },
  },

  "ask": "mid",                   // "soft" | "mid" | "hard"

  "verification": {
    "rules": "warn",              // a `rules` line the compiler can't verify
    "never": "warn",              // a `never` line the compiler can't verify
    "examples": "error",          // generated code fails one of its examples
    "unverifiedAi": "warn",       // a block with no examples or tests
    "customKeys": "warn",         // a custom key / instruction that can't be verified
  },

  "codegen": {                    // applies to every target language
    "modularity": "medium",       // "single-file" | "low" | "medium" | "high"
    "maxFunctionLines": 40,
    "safety": "strict",           // "basic" | "standard" | "strict" | "paranoid"
    "comments": "normal",         // "none" | "minimal" | "normal" | "detailed" | "teaching"
    "docstrings": true,
    "typing": "explicit",
    "optimizeFor": "balanced",    // "readability" | "balanced" | "speed" | "size"
    "errorHandling": "fail-fast", // or "recover"
    "logging": "info",
    "async": "auto",
    "naming": {
      "variables": "snake_case",
      "functions": "snake_case",
      "types": "PascalCase",
      "constants": "UPPER_CASE",
    },
    "format": { "indent": 4, "lineLength": 100 },
    "dependencies": {
      "policy": "allow-listed",   // "stdlib-only" | "allow-listed" | "any"
      "allowed": ["fastapi", "pydantic", "typer", "nlohmann-json", "cpp-httplib", "sqlitecpp", "spdlog", "catch2", "cli11"],
    },
    "tests": { "generate": "basic", "coverageTarget": 80 },

    // Custom key inside a known section: also allowed.
    "preferEarlyReturns": true,
  },

  // Free-text requirements, binding like any other setting.
  "instructions": [
    "Error messages shown to the user must be friendly and in plain English, with no stack traces.",
    "Never use recursion; use loops instead.",
    "Every public function starts with a one-line summary comment.",
  ],

  "llm": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "effort": "high",             // low | medium | high | xhigh | max (repeatability comes from fluid.lock)
    "maxRetries": 3,
    "confidence": 0.85,
    "offline": false,
    "contextFiles": ["docs/domain-notes.md"],
  },

  // Later entries win when several match.
  "overrides": [
    {
      // Anything that touches money: maximum safety, more explanation.
      "match": { "blocks": ["add expense", "cancel expense", "split bill"] },
      "ask": "hard",
      "codegen": { "safety": "paranoid", "comments": "detailed" },
      "verification": { "rules": "error" },
      "auditLog": "record who changed what, and the old and new values",   // custom key
    },
    {
      "match": { "keyword": "page" },
      "codegen": { "comments": "minimal", "optimizeFor": "size" },
      "accessibility": "WCAG 2.2 AA",                                      // custom key
    },
  ],

  // ---- custom keys: anything the schema doesn't know -----------------------
  // The LLM reads each one as a requirement. If it is clear, it is applied
  // and recorded in fluid.lock (see `fluid review`). If it isn't clear, the
  // builder asks, following the `ask` level.
  "commitMessageStyle": "conventional commits",
  "maxDependenciesPerModule": 3,
  "copyrightHeader": "Copyright 2026 <your name>. MIT License.",
  "databaseMigrations": "never change a column in place; always add a new one",
  "readme": { "generate": true, "language": "English", "includeApiExamples": true },
}
