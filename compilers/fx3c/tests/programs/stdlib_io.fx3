import File;
import Path;
import Csv;
import Db;
import Env;
import Log;
import Http;
import Server;
import Json;

function[<>|<>] @fails(IOError, FormatError, DbError, NetworkError) main2 = Function() {
    Path.makeDir("data")?;
    File.write(Path.join("data", "notes.txt"), "one\ntwo\n")?;
    File.append("data/notes.txt", "three\n")?;
    print(File.readLines("data/notes.txt")?, File.exists("data/notes.txt"), File.size("data/notes.txt")?);
    print(Path.name("data/notes.txt"), Path.ext("data/notes.txt"), Path.listDir("data")?);

    Csv.write("data/people.csv", [{"name": "Sam", "age": "25"}, {"name": "Ria", "age": "30"}])?;
    vector<map<string, string>> rows = Csv.read("data/people.csv")?;
    print(rows.size(), rows[1]["name"]);

    Db db = Db.open(":memory:")?;
    db.exec("create table expense (id integer primary key, amount integer, category text)")?;
    db.exec("insert into expense (amount, category) values (?, ?)", [500, "food"])?;
    db.exec("insert into expense (amount, category) values (?, ?)", [1500, "travel"])?;
    print("last id", db.lastId());
    vector<map<string, Json>> found = db.query("select category, amount from expense order by amount desc")?;
    repeat(auto r in found) {
        print(r["category"].asString() ?? "", r["amount"].asInt() ?? 0);
    }
    db.close();
}

function[<Request>|<Response>] hello = Function(Request req) {
    return Response.json({"hello": req.param("name") ?? "world"});
}
function[<Request>|<Response>] echo = Function(Request req) {
    return Response.text(req.body.upper(), status = 201);
}

try {
    main2();
} catch (Error e) {
    print("failed:", e.message);
}

print(Env.get("SURELY_NOT_SET") ?? "unset", Env.has("PATH"));
try {
    string x = Env.require("SURELY_NOT_SET");
    print(x);
} catch (ValueError e) {
    print("require:", e.message);
}

try {
    string missing = File.read("nope.txt");
    print(missing);
} catch (FileNotFound e) {
    print("caught:", e.message);
}

Server server = Server.create(port = 0);
server.get("/hello/{name}", hello);
server.get("/hello", hello);
server.post("/echo", echo);
server.start();
string base = f"http://127.0.0.1:{server.port}";
try {
    HttpResponse r1 = Http.get(base + "/hello/Sam");
    print(r1.status, r1.body, r1.ok());
    HttpResponse r2 = Http.get(base + "/hello?name=Ria");
    print((r2.json() ?? Json.of(none)).get("hello"));
    HttpResponse r3 = Http.post(base + "/echo", body = "shout", contentType = "text/plain");
    print(r3.status, r3.body);
    HttpResponse r4 = Http.get(base + "/missing");
    print(r4.status);
} catch (NetworkError e) {
    print("network:", e.message);
}
server.stop();
