from General import @all;

// =====================================================================
//  FluidXPro3: CLASSES & INTERFACES
// =====================================================================
//
//  SHAPE (from constructs.fx3):
//      class @annotations Name = Class(Parent?, implements = [Interfaces]?) {
//          fields;
//          constructors;
//          methods;
//      }
//
//  [LOCK] DEFAULTS
//    - Fields are @private by default. Methods are @public by default.
//    - Objects are REFERENCES: `Point b = a;` makes b point to the SAME
//      object (as in Python, Java, Swift). Use a.copy() for a separate
//      object, or mark the class @value (section 7).
//    - There is no `new`. A class is called like a function:
//      Point(2, 3). (`new Point(2, 3)` is accepted and becomes that.)
//    - `this` is available in every method and is never written as a
//      parameter.
//    - Single inheritance. Any number of interfaces.


// ---------------------------------------------------------------------
// 1. FIELDS
// ---------------------------------------------------------------------
class Account = Class() {
    string @public owner;                 // readable and writable from outside
    float balance = 0.0;                  // private (default), with a starting value
    string @readonly id;                  // set once in the constructor, then fixed
    int @static @public count = 0;        // shared by the whole class
    vector<string> history;
}


// ---------------------------------------------------------------------
// 2. CONSTRUCTORS
// ---------------------------------------------------------------------
//  - A function marked @constructor. It sets fields through `this` and
//    returns nothing.
//  - Several constructors are told apart by @style('name'), picked with
//    @using('name'), or automatically by the argument types.
//  - NO constructor written -> one is generated that takes the fields in
//    order. Fields with a starting value become optional arguments:
//        class P = Class() { int x; int y = 0; }    P(1)  or  P(1, 2)
class Temperature = Class() {
    float celsius;

    function[<float>|<>] @constructor @style('celsius') fromC = Function(float c) {
        this.celsius = c;
    }
    function[<float>|<>] @constructor @style('fahrenheit') fromF = Function(float f) {
        this.celsius = (f - 32) * 5 / 9;
    }
}
Temperature @using('fahrenheit') t1 = Temperature(98.6);
Temperature t2 = Temperature.fromC(37.0);          // or call the constructor by name

//  @destructor: runs when the last reference goes away (memory.fx3).
//  Rarely needed.


// ---------------------------------------------------------------------
// 3. METHODS
// ---------------------------------------------------------------------
class Counter = Class() {
    int value = 0;

    function[<int>|<>] add = Function(int n = 1) {
        this.value += n;
    }
    function[<>|<int>] @const get = Function() {    // @const: doesn't change the object
        return this.value;
    }
    function[<>|<Counter>] @static zero = Function() {
        return Counter();
    }
}
Counter k = Counter();
k.add();  k.add(5);
int now = k.get();


// ---------------------------------------------------------------------
// 4. PROPERTIES (computed fields)
// ---------------------------------------------------------------------
class Circle = Class() {
    float radius;

    function[<>|<float>] @property area = Function() => 3.14159 * this.radius ** 2;

    function[<>|<float>] @property diameter = Function() => this.radius * 2;
    function[<float>|<>] @setter diameter = Function(float d) { this.radius = d / 2; }
}
Circle cc = Circle(2.0);
print(cc.area);          // no () for a property
cc.diameter = 10;        // calls the setter


// ---------------------------------------------------------------------
// 5. INHERITANCE
// ---------------------------------------------------------------------
//  @open      the class can be inherited from (classes are FINAL by default)
//  @override  required on a method that replaces the parent's method
//  @abstract  a class that can't be created directly, or a method with no body
class @open @abstract Animal = Class() {
    string @public name;
    function[<>|<string>] @abstract sound;
    function[<>|<string>] describe = Function() => f"{this.name} says {this.sound()}";
}

class Dog = Class(Animal) {
    function[<>|<string>] @override sound = Function() => "woof";
}

class Puppy = Class(Dog) { }                  // error: Dog is not @open

Dog d = Dog("Rex");
print(d.describe());                          // "Rex says woof"
//  super.method(...) calls the parent's version.
//  super(...) inside a constructor calls the parent's constructor.


// ---------------------------------------------------------------------
// 6. INTERFACES (what a class promises to provide)
// ---------------------------------------------------------------------
//  Methods with no body must be implemented. Methods with a body are
//  defaults.
interface Drawable = Interface {
    function[<>|<>] draw;
    function[<>|<string>] label = Function() => "shape";     // default
}
interface Sized = Interface {
    function[<>|<float>] @property area;
}

class Square = Class(implements = [Drawable, Sized]) {
    float side;
    function[<>|<>] draw = Function() { print("■"); }
    function[<>|<float>] @property area = Function() => this.side ** 2;
}

function[<Drawable>|<>] render = Function(Drawable item) { item.draw(); }
render(Square(3.0));

//  The built-in interfaces from types.fx3 (comparable, equatable, hashable,
//  printable, numeric, copyable, iterable) are implemented the same way,
//  or generated with @derive.


// ---------------------------------------------------------------------
// 7. CLASS ANNOTATIONS
// ---------------------------------------------------------------------
//  Annotation           Meaning
//  -------------------  -----------------------------------------------------------
//  @value               copied on assignment, like a C struct or Rust struct
//                       (stack-allocated, no reference counting). Best for small
//                       data: Point, Color, Money
//  @derive(list)        generate: eq (==), hash, order (< >), print, copy, json
//  @open                can be inherited from
//  @abstract            can't be created directly
//  @error               can be used with `fail` (errors.fx3)
//  @immutable           every field is @readonly
//  @singleton           exactly one instance: Config.instance
//  @service             one instance per program, created at start and
//                       HANDED to whoever needs it (section 7b). Prefer it to
//                       @singleton for app components
//  @generic(T, ...)     generic class (types.fx3)
@value @derive(eq, hash, print) class Point2 = Class() { float x; float y; }
//   ^ error: annotations go AFTER the keyword. Correct form:
class @value @derive(eq, hash, print) Point2 = Class() { float x; float y; }


// ---------------------------------------------------------------------
// 7b. SERVICES (dependency injection)  [LOCK]
// ---------------------------------------------------------------------
//  A @service class is an application component: there is one of it per
//  program, made at start. Its fields whose type is another @service, or
//  a type some @provides function gives, are filled in automatically
//  ("injected"). Other fields need a starting value.
function[<>|<Db>] @provides @fails(IOError) appDb = Function() {
    return Db.open(DB_PATH)?;               // run once at start; closed at exit
}

class @service Inventory = Class() {
    Db db;                                   // injected: from appDb()
    function[<string>|<int>] @fails(DbError) stockOf = Function(string item) { ... }
}

class @service Orders = Class() {
    Inventory inventory;                     // injected: the one Inventory
    Db db;                                   // injected: the same Db
    int @readonly maxPerOrder = 10;          // not injected: has a value
}
//  - Web handlers, `every` jobs and other services get services the same
//    way: a parameter of a @service type is injected (web blocks,
//    FLUID_SPEC.md). `Orders orders = service(Orders);` gets one anywhere
//    else, e.g. in main. (fx3c so far: service(...) everywhere; injecting
//    handler parameters comes with the web block lowering.)
//  - A @provides function takes nothing and returns one object; it runs
//    once, the first time something needs that type. What it gives is
//    closed when the program ends, if it has close().
//  - Services are created in dependency order. A cycle is an error that
//    names the loop. A service that @fails to start stops the program
//    before anything runs.
//  - Being shared by every task, a service's changeable fields must be
//    locked<T> or atomic<T> (concurrency.fx3), like any shared state.
//  Each target: Java Spring @Service / @Bean + constructor injection; Go
//  and C++ a struct built in main and passed explicitly; Rust an AppState
//  passed to handlers; Python objects built in main.


// ---------------------------------------------------------------------
// 7c. FIELD CONSTRAINTS (checked where values come in)  [LOCK]
// ---------------------------------------------------------------------
//  Annotation            Also accepted            The value must
//  --------------------  -----------------------  ------------------------------------
//  @range(a, b)          @between(a, b)           be in [a, b] (numbers)
//  @min(a) / @max(b)                              be >= a / <= b
//  @length(a, b)         @len, @size              have a..b characters / elements
//  @notEmpty             @nonEmpty, @required     not be "" / empty
//  @pattern("regex")     @regex, @matches         match the whole regex
//  @email                                          look like an email address
class @value @derive(json) NewOrder = Class() {
    string @length(1, 80) item;
    int @range(1, 1000000) amountCents;
    string @email contact;
    string? @pattern("[A-Z]{2}[0-9]{4}") coupon;      // checked only when present
}
//  @length(n) alone means at most n.
//  When the checks run:
//    - when the object is built (the constructor). There a broken
//      constraint is a bug in the program: a panic, as for @range on a
//      variable.
//    - when a value comes from OUTSIDE: X.fromJson(json) (@derive(json)),
//      later also CSV rows. A failure there is a ValidationError
//      (errors.fx3) that names every field that is wrong, wrong types and
//      broken constraints together; a web handler that lets it through
//      answers 400 with {"error": ..., "fields": {...}} by itself.
//  @derive(json) gives X.fromJson(Json) @fails(ValidationError) and
//  x.toJson(). Fields can be numbers, text, bool, maybe, lists, sets,
//  map<string, ...>, simple enums (by name) and @derive(json) classes.
//  Each target: Java Jakarta Validation (@Min, @Max, @Size, @Pattern,
//  @Email, @NotBlank + @Valid); the others a generated validate().


// ---------------------------------------------------------------------
// 8. OPERATORS ON YOUR CLASSES
// ---------------------------------------------------------------------
class @value Vec2 = Class() {
    float x;
    float y;
    function[<Vec2>|<Vec2>] @operator(+) plus = Function(Vec2 o) => Vec2(this.x + o.x, this.y + o.y);
    function[<float>|<Vec2>] @operator(*) scale = Function(float k) => Vec2(this.x * k, this.y * k);
    function[<int>|<float>] @operator([]) at = Function(int i) => if (i == 0) this.x else this.y;
}
Vec2 v = Vec2(1, 2) + Vec2(3, 4) * 2.0;
//  Operators that can be defined: + - * / // % ** == < [] in, and the
//  unary - and not. (`!=`, `>`, `<=` and `>=` are derived automatically.)


// ---------------------------------------------------------------------
// 9. CHECKS
// ---------------------------------------------------------------------
//  - Reading or writing a @private field from outside the class        -> error
//  - Writing a @readonly field outside a constructor                   -> error
//  - A non-@abstract class leaves an interface or abstract method empty -> error
//  - A method replaces the parent's method without @override           -> error
//  - Inheriting from a class that isn't @open                          -> error
//  - A field has no value after the constructor, and no default        -> error
//  - == on a class without @derive(eq) or @operator(==)                -> error
//  - Two constructors can't be told apart by type or style             -> error
//  - A @const method changes `this`                                    -> error
//  - A cycle between @service classes                                  -> error
//  - A @service field with no value, no @provides and no @service type -> error
//  - A field constraint that can never hold (@range(5, 1), bad regex)  -> error
