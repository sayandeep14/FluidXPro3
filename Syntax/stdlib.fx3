// =====================================================================
//  FluidXPro3: STANDARD LIBRARY
// =====================================================================
//  [LOCK] This is the API that fx3c implements (compilers/fx3c/fx3c/stdlib.py
//  is the single source; every backend implements exactly these names).
//
//  - `General` (print, input, len, ...) is always available.
//  - Every other module must be imported at the top of the file:
//        import Math;                    Math.sqrt(2.0)
//        import Math as M;               M.sqrt(2.0)
//        from Math import sqrt, pi;      sqrt(2.0)
//        from Math import @all;
//  - Importing a module also brings in its types (import Http -> HttpResponse), and every
//    standard type its functions use (import Db -> Json, because queries return Json).
//  - Standard values are made with functions (Time.now(), Db.open(...)), never
//    with Type(...).
//  - Functions marked @fails(...) must be handled like any other failing call.

import Json;
import Server;


// ---------------------------------------------------------------------
// General (always available)
// ---------------------------------------------------------------------
//  print(values..., sep = " ", end = "\n")   input(prompt = "") -> string
//  len(x)  min(a, b)  max(a, b)  abs(x)  round(x)  round(x, digits)  floor(x)  ceil(x)
//  sum(collection)  sorted(collection)  range(a, b)  string(x)
//  sleep(duration)   panic(message)   ensure(condition, message)   exit(code = 0)
//
//  Durations: 500ms  2s  5m  1h  1d   (type `duration`)
//    d + d, d - d, d * number, d / number -> duration;  d / d -> float;  compare with < >
//    .seconds()  .millis()  .minutes()  .hours()  .toString()
//    printed as: 500ms, 3.5s, 1m 30s, 2h
//  Sizes: 512b  4kb  10mb  2gb  -> int bytes (1kb = 1024 bytes)


// ---------------------------------------------------------------------
// Math
// ---------------------------------------------------------------------
//  sqrt pow log log10 log2 exp sin cos tan asin acos atan atan2 hypot
//  clamp(value, low, high) (same type as value)   lerp(a, b, t)
//  gcd(a, b)  lcm(a, b)  isPrime(n)  factorial(n)
//  constants: Math.pi  Math.e  Math.tau  Math.inf
//  Impossible inputs (sqrt(-1), log(0)) panic with a clear message.


// ---------------------------------------------------------------------
// Random
// ---------------------------------------------------------------------
//  Random.int(low, high)    both ends included
//  Random.float()           0.0 (included) to 1.0 (excluded)
//  Random.chance(p)         true with probability p
//  Random.pick(items)       a random element (panics if empty)
//  Random.shuffle(items)    shuffles a list in place (@ref)
//  Random.seed(n)           makes the numbers repeatable


// ---------------------------------------------------------------------
// Time (local time)
// ---------------------------------------------------------------------
//  Time.now()  Time.today()  Time.of(year, month, day, hour = 0, minute = 0, second = 0) @fails(ValueError)
//  Time.parse(text, format = "YYYY-MM-DD") @fails(ParseError)
//  Time.since(start) -> duration
//  t.year() .month() .day() .hour() .minute() .second() .weekday() (1 = Monday) .weekdayName() .monthName()
//  t.format(pattern = "YYYY-MM-DD HH:mm:ss")   tokens: YYYY MM DD HH mm ss MMM MMMM ddd dddd
//  t.plus(duration)  t.minus(duration)  t.diff(other) -> duration  t.isBefore(other)  t.isAfter(other)
//  t.date() (midnight)   t.toString()
//  Times compare with == < > and can be map keys.


// ---------------------------------------------------------------------
// File and Path (paths are text)
// ---------------------------------------------------------------------
//  File.read(path) -> string                      @fails(IOError)
//  File.readLines(path) -> vector<string>         @fails(IOError)
//  File.write(path, text)   File.writeLines(path, lines)   File.append(path, text)   @fails(IOError)
//  File.exists(path) -> bool   File.delete(path)   File.copy(source, target)   File.move(source, target)
//  File.size(path) -> int (bytes)
//  (IOError has the subtypes FileNotFound and PermissionDenied)
//
//  Path.join(parts...)  Path.name(p)  Path.stem(p)  Path.ext(p) ("txt", no dot)  Path.parent(p)
//  Path.absolute(p)  Path.cwd()  Path.isDir(p)  Path.isFile(p)
//  Path.listDir(dir = ".")  Path.walk(dir = ".")  Path.makeDir(p)   @fails(IOError)


// ---------------------------------------------------------------------
// Csv: rows are map<string, string> (column name -> text)
// ---------------------------------------------------------------------
//  Csv.read(path) @fails(IOError, FormatError)   Csv.parse(text) @fails(FormatError)
//  Csv.write(path, rows) @fails(IOError)          Csv.stringify(rows) -> string


// ---------------------------------------------------------------------
// Json
// ---------------------------------------------------------------------
//  Json.parse(text) -> Json @fails(FormatError)
//  Json.stringify(value, pretty = false) -> string   (any value: collections, objects, Time, Json)
//  Json.of(value) -> Json
//  j.get(key) -> Json (missing -> null)   j.at(index)   j.has(key)   j.keys()   j.size()
//  j.isNull() .isString() .isNumber() .isBool() .isList() .isObject()
//  j.asString() -> string?   .asInt() -> int?   .asFloat() -> float?   .asBool() -> bool?
//  j.asList() -> vector<Json>   j.toString()
Json user = Json.parse("{\"name\": \"Sam\", \"age\": 25}") ?? Json.of(none);
string name = user.get("name").asString() ?? "unknown";


// ---------------------------------------------------------------------
// Env and Log
// ---------------------------------------------------------------------
//  Env.get(name) -> string?   Env.require(name) -> string @fails(ValueError)   Env.has(name)
//  Env.args() -> vector<string>   Env.platform() -> "macos" | "linux" | "windows"
//  secrets.env (next to the program or in a folder above it) is loaded when the program
//  starts. Variables that are already set win.
//  [LOCK] Secrets never print. A value from secrets.env, or one read with Env from a
//  variable whose name says it is secret (KEY, TOKEN, SECRET, PASSWORD, AUTH, ...), shows as
//  **** in print, Log, panics, failed tests and Response.error. (Values under 6 characters
//  aren't masked: they would hide ordinary words.)
//
//  Log.debug(msg)  Log.info(msg)  Log.warn(msg)  Log.error(msg)   Log.level("debug" | "info" | "warn" | "error")
//  Written to the error output as: 2026-10-30 12:00:01 INFO  message


// ---------------------------------------------------------------------
// Http (client)
// ---------------------------------------------------------------------
//  Http.get(url, headers = {}, timeout = 30s, retries = 2)
//  Http.post(url, body = "", contentType = "application/json", headers = {}, timeout = 30s)
//  Http.put(..., retries = 2)   Http.delete(url, headers = {}, timeout = 30s, retries = 2)   Http.postJson(url, value, ...)
//    -> HttpResponse   @fails(NetworkError)  (TimeoutError / ConnectionError are kinds of NetworkError)
//  HttpResponse: .status (int)  .body (string)  .headers  .ok() (200-299)  .json() @fails(FormatError)
//  A 404 or 500 answer is NOT a failure: check .status or .ok().
//  [LOCK] TLS certificates and host names are always checked; there is no switch to turn that off.
//  [LOCK] The timeout must be more than 0 (a panic otherwise): no call waits forever.
//  [LOCK] GET, PUT and DELETE are retried `retries` times after a connection error, a timeout or a
//  502 / 503 / 504, waiting 0.5s, 1s, 2s ... (with jitter). POST is never retried.


// ---------------------------------------------------------------------
// Server
// ---------------------------------------------------------------------
//  Server.create(port = 8080)          (port 0 = any free port; read it back from .port;
//                                       SERVER_PORT in the environment wins)
//  s.get(path, handler)  s.post(...)  s.put(...)  s.delete(...)
//      handler: a function[<Request>|<Response>]; paths can have parameters: "/items/{id}"
//  s.start() (in the background)   s.stop()   s.keepRunning() (serve until Ctrl+C or SIGTERM)
//  [LOCK] Safe by default:
//    - request bodies up to 1 MB: a bigger one is answered 413 without being read
//    - a client that is slower than 30s is disconnected
//    - no CORS headers: browsers on other sites can't call the API
//    - every answer has X-Content-Type-Options: nosniff
//    - one JSON access-log line per request (method, path, status, ms; never the query string)
//    - stopping finishes the requests in progress first
//  s.limits(maxBodyKb = 1024, timeout = 30s)
//  s.allowOrigins(["https://app.example.com"])            ("*" = any site)
//  s.requireHeader("X-Api-Key", Env.require("API_KEY"), ["/health"])
//      every path but the open ones needs the header with that value; 401 otherwise.
//      Compared in constant time; the value is masked like a secret.
//  s.accessLog(false)
//  Request: .method .path .body .query .params .headers   .param(name) -> string?   .json() @fails(FormatError)
//  Response.text(body, status = 200)  Response.json(value, status = 200)  Response.html(body, status = 200)
//  Response.notFound(message = "not found")  Response.error(message, status = 500)  Response.redirect(url)
//  A handler that fails, or panics, answers 500 with {"error": message}. The server keeps running.
//  Listens on 127.0.0.1 unless SERVER_HOST is set (e.g. SERVER_HOST=0.0.0.0).
function[<Request>|<Response>] hello = Function(Request req) {
    return Response.json({"hello": req.param("name") ?? "world"});
}
// Server s = Server.create(port = 8080);  s.get("/hello/{name}", hello);  s.keepRunning();


// ---------------------------------------------------------------------
// Db (SQLite: a file, or ":memory:")
// ---------------------------------------------------------------------
//  Db.open(path) -> Db @fails(IOError)
//  db.exec(sql, params = []) -> int (changed rows)            @fails(DbError)
//  db.query(sql, params = []) -> vector<map<string, Json>>     @fails(DbError)
//  db.queryOne(sql, params = []) -> map<string, Json>?          @fails(DbError)
//  db.lastId() -> int   db.close()
//  Use ? placeholders: db.exec("insert into t (a, b) values (?, ?)", [1, "x"])?;
//  [LOCK] SQL text built from values is a compile error (FX0480): only literals and @const
//  values may go into the text itself, inline or through a variable. Everything else goes in params.
//      db.query(f"select * from t where name = '{name}'")      // FX0480
//      db.query("select * from t where name = ?", [name])       // right
//  Foreign keys are enforced.
//
//  Transactions:
//  db.transaction(Function() { db.exec(...) ... })  @fails(DbError)
//      commits when the function ends; if it fails or panics, everything is rolled back
//  db.begin() @fails(DbError)   db.commit() @fails(DbError)   db.rollback()
//      while a transaction is open, other threads using the same Db wait
//
//  Migrations:
//  db.migrate("migrations") -> int  @fails(IOError, DbError)
//      runs the folder's *.sql files that haven't run yet, in name order (001_init.sql,
//      002_add_email.sql, ...), each in its own transaction, and records them in the table
//      fx3_migrations. A file that fails is rolled back and stops the migration.


// ---------------------------------------------------------------------
// Ai: Claude while the program runs (needs ANTHROPIC_API_KEY, e.g. in secrets.env)
// ---------------------------------------------------------------------
//  Ai.ask(prompt, system = "", model = "claude-opus-5-5") -> string                   @fails(AiError)
//  Ai.classify(text, options, instructions = "", model = "claude-opus-5-5") -> string @fails(AiError)
//      always returns one of the options (structured output)


// ---------------------------------------------------------------------
// Email (SMTP: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM)
// ---------------------------------------------------------------------
//  Email.send(to, subject, body) @fails(NetworkError)


// ---------------------------------------------------------------------
// Schedule (jobs that repeat)
// ---------------------------------------------------------------------
//  Schedule.every(interval, job, at = "", name = "")
//      job: a function[<>|<>]; at = "HH:MM" (local time) for intervals of whole days
//  Schedule.run()          runs the jobs when they are due, until Ctrl+C / SIGTERM
//  Schedule.runPending()   runs the jobs that are due now, once -> int (how many)
//  [LOCK] The last run of every job is saved (SCHEDULE_STATE, default .fx3-schedule.json).
//  A restart doesn't repeat a run that already happened. After downtime, a missed job
//  runs once, not once per missed time. A job that fails or panics is logged with its
//  source line, and the other jobs go on.
//      Schedule.every(1d, sendReport, at = "21:00", name = "send report");
//      Schedule.every(5m, Function() { checkQueue(); });
//      Schedule.run();
//  With a server: s.start(); then Schedule.run(); (not s.keepRunning()).


// ---------------------------------------------------------------------
// Process (run another program)
// ---------------------------------------------------------------------
//  Process.run(command, input = "", timeout = 60s) -> ProcessResult  @fails(IOError, TimeoutError)
//      command: vector<string>, the program and then its arguments
//  ProcessResult: .code (int)  .out (string)  .err (string)  .ok() (code 0)
//  [LOCK] Never through a shell. Every argument is passed as it is, so text like
//  "a; rm -rf ~" is one argument, never a second command. A program that isn't found
//  is an IOError; one that runs past the timeout is stopped (TimeoutError).
//  Process can't run in the verification sandbox: tests can't start other programs.


// ---------------------------------------------------------------------
// Testing
// ---------------------------------------------------------------------
//  @test functions and @example cases run with `fx3c test` (constructs.fx3).
//  ensure(condition, message) is the check inside a test.


