from General import @all;

// =====================================================================
//  FluidXPro3: CONCURRENCY
// =====================================================================
//
//  [LOCK] Data races are a COMPILE ERROR. Anything shared between tasks
//  that can be changed must be locked<T>, atomic<T>, @concurrent, or sent
//  through a channel.
//
//  [LOCK] THE TASK MODEL (the same on every target; targets.fx3)
//    - Tasks may run in parallel, on OS threads or virtual threads.
//    - Nothing orders two tasks except await, channels, locked<T>,
//      atomic<T> and group. Output that depends on scheduling is a bug.
//    - @async marks a function that WAITS (on the network, a timer, a
//      channel). On targets without async/await (Go, Java) it is a plain
//      function: spawn starts a goroutine / virtual thread, and await waits
//      for it. On Rust, tokio is used when the program has @async functions
//      or a Server; otherwise std::thread.


// ---------------------------------------------------------------------
// 1. ASYNC FUNCTIONS & AWAIT
// ---------------------------------------------------------------------
//  @async functions return task<T> right away. `await` waits for the result.
function[<string>|<string>] @async @fails(NetworkError) download = Function(string url) {
    return await Http.get(url)?.text();
}

function[<>|<>] @async @entry main = Function() {
    string page = await download("https://example.com") ?? "";

    // Several at once:
    task<string> t1 = download("https://a.com");
    task<string> t2 = download("https://b.com");
    auto [p1, p2] = await all(t1, t2);           // wait for both
    string fastest = await any(t1, t2);          // the first one to finish
    string slow = await t1 @timeout(5s) ?? "timed out";
}
//  await only works inside an @async function. A normal @entry main may
//  call run(task) to block until it finishes.


// ---------------------------------------------------------------------
// 2. SPAWNING (running something in the background)
// ---------------------------------------------------------------------
task<int> job = spawn heavyWork(42);           // starts at once, on any thread
int answer = await job;
job.cancel();                                  // cooperative cancellation
//  A panic inside a task stops only that task. Awaiting it then fails with
//  TaskPanicked (the one place a panic can be caught; errors.fx3).


// ---------------------------------------------------------------------
// 2b. GROUPS (structured concurrency)  [LOCK]
// ---------------------------------------------------------------------
//  group { } waits for every task spawned inside it before the program
//  goes on. If one task fails, the others are cancelled and the group
//  fails with that error (so the enclosing function needs @fails for it,
//  or handles it with try / ?? as usual). A panic in a task is re-raised
//  as TaskPanicked.
function[<string>|<Report>] @fails(NetworkError) @async dashboard = Function(string user) {
    group {
        task<vector<Order>> orders = spawn loadOrders(user);
        task<Profile> profile = spawn loadProfile(user);
    }                                            // both have finished here
    return Report(await orders, await profile);  // already done: no waiting
}
//  [LOCK] Scope: unlike other blocks, the task<T> variables declared
//  DIRECTLY inside a group stay visible after it (finished, so `await`
//  doesn't wait). Every other name declared inside stays inside.
//  Why it matters: a task inside a group may READ local variables of the
//  enclosing function, because the group can't outlive them. A task
//  started outside a group can only use what it was given (copies,
//  shared<T>, sync<T>, channels).
//    - Writing a captured local from a task is still a data race (error),
//      unless it is locked<T> or atomic<T>.
//    - `group @limit(4) { ... }` runs at most 4 of its tasks at a time.
//  Each target: Go errgroup.Group, Java StructuredTaskScope, Rust
//  thread::scope / tokio JoinSet, C++ jthreads joined at the closing
//  brace, Python a thread pool.


// ---------------------------------------------------------------------
// 3. PARALLEL LOOPS & PIPELINES
// ---------------------------------------------------------------------
repeat @parallel (auto img in images) {        // each iteration may run on its own core
    img.resize(256, 256);
}
//  The compiler checks that the body doesn't write variables shared between
//  iterations. Results can be gathered safely with a query method instead:
vector<Image> thumbs = images.map(currVal.resized(256, 256), parallel = true);
//  Pipelines marked @parallel run independent stages at the same time
//  (constructs.fx3).


// ---------------------------------------------------------------------
// 4. SHARING STATE
// ---------------------------------------------------------------------
atomic<int> hits = 0;                  // lock-free counter
hits += 1;                             // atomic increment

locked<map<string, int>> scores = {};  // only one task at a time
with (scores) {                        // locks, then unlocks at the end of the block
    scores["sam"] = 10;
}
//  Reading or writing a locked<T> outside `with` is a compile error, so
//  you can never forget to lock.

map<string, int> @concurrent cache;    // a concurrent map: safe without `with`


// ---------------------------------------------------------------------
// 5. CHANNELS (pass messages instead of sharing)
// ---------------------------------------------------------------------
channel<string> @capacity(100) jobs;
spawn worker(jobs);                    // a channel can be given to many tasks
jobs.send("resize:1.png");             // waits if the channel is full
string? next = await jobs.receive();   // none once the channel is closed and empty
jobs.close();
repeat(auto msg in jobs) { }           // loop until closed


// ---------------------------------------------------------------------
// 5b. SELECT (wait for whichever is ready first)  [LOCK]
// ---------------------------------------------------------------------
//  Each case binds what it received, like if-bind (types.fx3). The first
//  case that is ready runs; if several are ready at once, any one of them
//  may run. `after(d)` is ready once d has passed; `default` runs at once
//  when nothing is ready (then select never waits).
select {
    case (string job = jobs.receive()) { handle(job); }
    case (Event e = events.receive())  { log(e); }
    case (after(5s))                    { print("idle"); }
}
//  - A closed channel's receive() is ready and gives none: bind it as a
//    maybe (string? job = ...) to see that, otherwise the case is skipped
//    once its channel is closed.
//  - Sending can be a case too: case (results.send(r)) { ... }
//  - select only appears where waiting is allowed (inside @async, or in a
//    task). Each target: Go select, Rust crossbeam::select! /
//    tokio::select!, Java and C++ a runtime helper, Python a helper on
//    queue.Queue.


// ---------------------------------------------------------------------
// 6. TIMING
// ---------------------------------------------------------------------
await sleep(500ms);
task<> ticker = every(1s, Function() { print("tick"); });   // repeats in the background
ticker.cancel();
after(10s, Function() { print("done"); });


// ---------------------------------------------------------------------
// 7. CHECKS
// ---------------------------------------------------------------------
//  - Something that can be changed is shared between tasks without
//    locked / atomic / @concurrent / channel                     -> error
//  - await outside an @async function                            -> error
//  - A locked<T> is used outside `with`                          -> error
//  - Nested `with` blocks that could deadlock (taken in different
//    orders in different places)                                 -> warning
//  - A task<T> is dropped without being awaited or cancelled     -> warning
//  - A task in a group writes a captured local (not locked/atomic) -> error
//  - A task outside a group captures a local by reference          -> error
//  - select with no case, or two `default` cases                   -> error
